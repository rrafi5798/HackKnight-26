{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "type": "local",
      "command": ["npx", "-y", "@upstash/context7-mcp"],
      "env": { "DEFAULT_MINIMUM_TOKENS": "" },
      "enabled": true
    },
    "voicebox": {
      "type": "remote",
      "url": "http://127.0.0.1:17493/mcp",
      "headers": {
        "X-Voicebox-Client-Id": "opencode"
      },
      "enabled": true
    },
    "zai-mcp-server": {
            "type": "local",
            "command": ["npx","-y","@z_ai/mcp-server"],
            "environment": {
                "Z_AI_API_KEY": "9ff861584b2e4904b5431f16b827d7e1.SP2TLPJjrncmu8nb",
                "Z_AI_MODE": "ZAI"
            }
        },
    "gemma-vision": {
      "type": "local",
      "command": ["node", "index.mjs"],
      "cwd": ".opencode/mcp/gemma-vision",
      "environment": {
        "OLLAMA_HOST": "http://127.0.0.1:11434",
        "GEMMA_MODEL": "gemma4:26b"
      },
      "enabled": true
    }
  }
}
